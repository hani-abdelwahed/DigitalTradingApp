{
  "name": "@dta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@dta/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^5.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}

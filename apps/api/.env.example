# Copy to apps/api/.env and fill in.
NODE_ENV=development
PORT=4000
# Postgres: a Neon/Supabase connection string, or a local server.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading
# Redis: an Upstash rediss:// URL, or a local server.
REDIS_URL=redis://localhost:6379
# Origin of the web app, for CORS.
WEB_ORIGIN=http://localhost:5173
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# 32-byte key (base64) used to encrypt MFA secrets at rest.
ENCRYPTION_KEY=

# Copy to apps/api/.env and fill in.
NODE_ENV=development
PORT=4000
# Postgres: a Neon/Supabase connection string, or a local server.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading
# Redis: an Upstash rediss:// URL, or a local server.
REDIS_URL=redis://localhost:6379
# Origin of the web app, for CORS. Must be https:// in production.
WEB_ORIGIN=http://localhost:5173
# Set to true only behind a reverse proxy or load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# 32-byte key (base64) used to encrypt MFA secrets at rest.
ENCRYPTION_KEY=

# --- Market data ---
# Crypto prices come from Binance's public market data (no account needed).
BINANCE_ENABLED=true
# Stocks/ETFs: with Alpaca keys (a free paper-trading account works) prices are real;
# without them the app shows clearly labelled simulated prices.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex is free; sip needs a paid Alpaca data plan.
ALPACA_FEED=iex

# --- Risk controls ---
# Largest single order, in USD or USDT.
MAX_ORDER_NOTIONAL=1000000
MAX_OPEN_ORDERS=100
# Refuse limit prices more than this % through the market (likely typos).
PRICE_BAND_PERCENT=10
# Pause a symbol for CIRCUIT_BREAKER_HALT_SECONDS when its price moves more than
# CIRCUIT_BREAKER_PERCENT within CIRCUIT_BREAKER_WINDOW_SECONDS. 0 turns it off.
CIRCUIT_BREAKER_PERCENT=10
CIRCUIT_BREAKER_WINDOW_SECONDS=300
CIRCUIT_BREAKER_HALT_SECONDS=300

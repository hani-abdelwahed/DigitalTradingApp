{
  "name": "digital-trading-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @dta/api dev",
    "dev:web": "pnpm --filter @dta/web dev",
    "db:migrate": "pnpm --filter @dta/api db:migrate"
  },
  "packageManager": "pnpm@10.28.0"
}
